DELIMITER //

CREATE PROCEDURE view_menu(IN choice INT)
BEGIN
    CASE choice

        WHEN 1 THEN
            CREATE OR REPLACE VIEW employee_view AS
            SELECT emp_id, emp_name, salary
            FROM employee;

        WHEN 2 THEN
            SELECT * FROM employee_view;

        WHEN 3 THEN
            UPDATE employee_view
            SET salary = 35000
            WHERE emp_id = 1;

        WHEN 4 THEN
            DROP VIEW IF EXISTS employee_view;

        WHEN 5 THEN
            SELECT 'Exit selected' AS Message;

        ELSE
            SELECT 'Invalid Choice' AS Message;

    END CASE;
END //

DELIMITER ;
