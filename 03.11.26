<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Electro Products</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Header Section -->
    <header>
        <h1>⚡ ELECTRO</h1>
        <nav aria-label="Main navigation">
            <a href="#home">Home</a>
            <a href="#products">Products</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <main>
        <!-- Home Section -->
        <section id="home" class="hero">
            <article class="hero-content">
                <h2>Power Your World</h2>
                <p>Discover premium electrical products for your home and business.</p>
                <a href="#products" class="btn">Explore Products</a>
            </article>
            <div class="hero-image" aria-hidden="true">⚡</div>
        </section>

        <!-- Products Section -->
        <section id="products" class="products">
            <h2>Our Products</h2>
            <div class="product-container">
                <article class="card">
                    <div class="product-icon" aria-hidden="true">💡</div>
                    <h3>LED Lights</h3>
                    <p>Bright and energy-efficient lights.</p>
                    <a href="#contact">View Details</a>
                </article>
                <article class="card">
                    <div class="product-icon" aria-hidden="true">🔌</div>
                    <h3>Switches</h3>
                    <p>Modern and stylish switches.</p>
                    <a href="#contact">View Details</a>
                </article>
                <article class="card">
                    <div class="product-icon" aria-hidden="true">🔋</div>
                    <h3>Electrical Items</h3>
                    <p>Quality electrical accessories.</p>
                    <a href="#contact">View Details</a>
                </article>
            </div>
        </section>

        <!-- About Section -->
        <section id="about" class="about">
            <h2>About Our Shop</h2>
            <p>We provide high-quality electrical products with reliable service and affordable prices.</p>
        </section>
    </main>

    <!-- Footer Section -->
    <footer id="contact">
        <h2>Contact Us</h2>
        <p>📍 Madurai, Tamil Nadu</p>
        <p>📞 93441 55170</p>
        <p>© 2026 Electro Products. All Rights Reserved.</p>
    </footer>
</body>
</html>

 {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background-color: #f4f7fb;
}

/* Header */
header {
    background-color: #071a2d;
    color: white;
    padding: 20px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

header h1 {
    color: #00e6a0;
}

/* Navigation */
nav {
    display: flex;
    gap: 30px;
}

nav a {
    color: white;
    text-decoration: none;
    transition: 0.3s;
}

nav a:hover {
    color: #00e6a0;
}

/* Hero section */
.hero {
    background: linear-gradient(120deg, #071a2d, #123c55);
    color: white;
    padding: 100px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.hero-content h2 {
    font-size: 50px;
    color: #00e6a0;
    margin-bottom: 20px;
}

.hero-content p {
    font-size: 18px;
    margin-bottom: 30px;
    line-height: 1.6;
    max-width: 500px;
}

/* Button transition and transform */
.btn {
    display: inline-block;
    background-color: #00e6a0;
    color: #071a2d;
    padding: 14px 25px;
    border-radius: 30px;
    text-decoration: none;
    transition: 0.4s;
}

.btn:hover {
    background-color: white;
    transform: scale(1.1);
}

/* Floating animation */
.hero-image {
    font-size: 150px;
    animation: floating 3s infinite ease-in-out;
}

@keyframes floating {
    0% { transform: translateY(0); }
    50% { transform: translateY(-25px); }
    100% { transform: translateY(0); }
}

/* Products section */
.products {
    padding: 70px 7%;
    text-align: center;
}

.products h2 {
    font-size: 35px;
    margin-bottom: 40px;
    color: #071a2d;
}

.product-container {
    display: flex;
    justify-content: center;
    gap: 30px;
}

.card {
    background-color: white;
    padding: 30px;
    width: 30%;
    border-radius: 15px;
    box-shadow: 0 5px 20px #00000015;
    transition: 0.4s;
}

.card:hover {
    transform: translateY(-15px);
    box-shadow: 0 10px 25px #00b88a40;
}

.product-icon {
    font-size: 55px;
    margin-bottom: 20px;
    transition: 0.4s;
}

.card:hover .product-icon {
    transform: scale(1.2) rotate(10deg);
}

.card h3 {
    margin-bottom: 15px;
    color: #071a2d;
}

.card p {
    margin-bottom: 20px;
    color: #555;
    line-height: 1.5;
}

.card a {
    color: #009c73;
    text-decoration: none;
}

/* About section */
.about {
    background-color: #dffaf1;
    padding: 60px 7%;
    text-align: center;
}

.about h2 {
    margin-bottom: 20px;
    color: #071a2d;
}

/* Footer */
footer {
    background-color: #071a2d;
    color: white;
    text-align: center;
    padding: 40px 20px;
    line-height: 2;
}

/* Responsive layout for small screens */
@media (max-width: 700px) {
    header {
        flex-direction: column;
        gap: 20px;
    }

    nav {
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
    }

    .hero {
        flex-direction: column;
        text-align: center;
        gap: 40px;
    }

    .hero-content h2 {
        font-size: 35px;
    }

    .product-container {
        flex-direction: column;
    }

    .card {
        width: 100%;
    }
}

